<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>e7fdf524-b727-41f1-8978-a8c694a7be0c</UserSecretsId>
        <LangVersion>15</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CloudinaryDotNet" Version="1.29.3"/>
        <PackageReference Include="EntityFrameworkCore.Exceptions.PostgreSQL" Version="11.0.0" />
        <PackageReference Include="FastEndpoints" Version="9.0.0" />
        <PackageReference Include="FastEndpoints.OpenApi" Version="9.0.0" />
        <PackageReference Include="FastEndpoints.Security" Version="9.0.0" />
        <PackageReference Include="Google.Apis.Admin.Directory.directory_v1" Version="1.78.0.4325" />
        <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
        <PackageReference Include="Google.Apis.Calendar.v3" Version="1.78.0.4320" />
        <PackageReference Include="Google.Apis.Drive.v3" Version="1.78.0.4327" />
        <PackageReference Include="Google.Apis.Gmail.v1" Version="1.78.0.4327" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0" />
        <PackageReference Include="MimeKit" Version="5.0.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
        <PackageReference Include="Sentry.AspNetCore" Version="7.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\Dockerfile">
            <Link>Dockerfile</Link>
        </Content>
    </ItemGroup>

</Project>